# Application Settings
PROJECT_NAME="Lost and Found Management System"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Security Settings
# Generate a secure key in production (e.g. using `openssl rand -hex 32`)
SECRET_KEY="development-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration (Default: local SQLite database; PostgreSQL compatible)
DATABASE_URL="sqlite:///./lostfound.db"

# CORS Configuration (JSON array of allowed frontend origins)
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000"]'

# Upload Storage Configuration
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=5242880
